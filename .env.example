# OpenRouter API key (https://openrouter.ai)
# Required for the legal assistant. Without it, the API returns the constitutional summary fallback.
OPENROUTER_API_KEY=

# Optional override for the model used by the assistant.
# Defaults to "deepseek/deepseek-r1:free".
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Public site URL used for canonical links, sitemap, and OpenRouter referrer header.
# Set this to your production URL on Vercel.
NEXT_PUBLIC_SITE_URL=https://basiclaw.vercel.app
