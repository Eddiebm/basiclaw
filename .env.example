# =============================================================================
# Core
# =============================================================================
# OpenRouter API key (https://openrouter.ai). Without it, /api/chat returns a short fallback.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b:free

NEXT_PUBLIC_SITE_URL=https://basiclaw.vercel.app

# =============================================================================
# Clerk (optional — graceful degrade when unset)
# =============================================================================
# When BOTH are set: ClerkProvider, /[locale]/sign-in + sign-up, /dashboard, /api/me/*.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated emails that may access /[locale]/admin/* when Clerk is enabled (in addition to publicMetadata.role === "admin").
ADMIN_EMAILS=

# =============================================================================
# Storage — Upstash Redis / Vercel KV (optional)
# =============================================================================
# Prefer Vercel Marketplace KV names; classic Upstash names also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Without Redis: JSON file at tmp/basiclaw-storage.json (ephemeral on serverless).

# =============================================================================
# Stripe (optional — checkout + webhooks)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs mapped in src/lib/stripe-plan.ts → Clerk publicMetadata.plan
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=

# =============================================================================
# Resend (optional — lawyer leads, Right of the Day cron)
# =============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LAWYER_LEADS_EMAIL=

# Right of the Day digest (verified domain in Resend)
RIGHT_OF_DAY_FROM_EMAIL=

# =============================================================================
# Cron & newsletter security
# =============================================================================
# Manual non-Vercel runs in production: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# HMAC for /api/unsubscribe?token=… (prefer dedicated secret in production)
UNSUBSCRIBE_SECRET=

# =============================================================================
# Shared audit links (HMAC; optional — falls back to CLERK_SECRET_KEY in dev)
# =============================================================================
SHARED_AUDIT_SECRET=

# =============================================================================
# Build-time LLM for US state cards (optional)
# =============================================================================
BUILD_LLM_KEY=
# BUILD_LLM_MODEL=openai/gpt-oss-20b:free
