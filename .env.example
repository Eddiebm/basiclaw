# =============================================================================
# BasicLaw env reference (canonical — generated by docs/vercel-env-setup.md audit)
#
# Required vs optional:
#   required-prod = app boots without it, but the related feature degrades or 404s in production
#   recommended  = strongly suggested before broad launch
#   optional     = local dev / nice-to-have / fallback path exists
#
# Real secrets must NEVER live in this file. Use placeholders only.
# Set actual values via `vercel env add` per docs/vercel-env-setup.md.
# =============================================================================

# =============================================================================
# Core
# =============================================================================
# Canonical site URL (no trailing slash). Used by metadata, OG, sitemap, robots,
# Stripe return URLs, internal-health self-fetch, JSON-LD, email links.
# Falls back to https://basiclaw.app in code, but set this in Production/Preview.
NEXT_PUBLIC_SITE_URL=https://basiclaw.app

# =============================================================================
# Auth — Clerk (optional; both must be set together)
# =============================================================================
# When BOTH are set: <ClerkProvider>, /[locale]/sign-in + sign-up, /dashboard,
# /api/me/*, answers publish/vote/delete, admin routes — all activate.
# When unset: routes still render with banners, write-paths return 401.
# recommended (production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Comma-separated emails granted /[locale]/admin/* in addition to publicMetadata.role === "admin". optional
ADMIN_EMAILS=ops@basiclaw.app,founder@basiclaw.app

# =============================================================================
# LLM — Vercel AI Gateway / OpenRouter (need at least ONE for chat + audit)
# =============================================================================
# Preferred path for /api/chat and /api/audit when set (https://vercel.com/docs/ai-gateway). recommended
AI_GATEWAY_API_KEY=
# Fallback when AI_GATEWAY_API_KEY is unset (https://openrouter.ai). recommended
OPENROUTER_API_KEY=sk-or-xxx
# Optional model override for chat. Default: openai/gpt-oss-20b:free
OPENROUTER_MODEL=
# Optional audit-specific model override (otherwise OPENROUTER_MODEL → default).
OPENROUTER_AUDIT_MODEL=
# Optional embeddings model for query-embed.ts when provider=openrouter and for scripts/embed-snippets.mjs.
# Default: openai/text-embedding-3-small
OPENROUTER_EMBEDDING_MODEL=
# Build-time only: enriches per-US-state pages with LLM summaries during `next build`. optional
BUILD_LLM_KEY=
# Optional model override for BUILD_LLM_KEY runs. Default: openai/gpt-oss-20b:free
BUILD_LLM_MODEL=

# =============================================================================
# Stripe (optional; required for paid tiers)
# =============================================================================
# Server secret used by /api/checkout, /api/portal, /api/webhooks/stripe, internal health.
STRIPE_SECRET_KEY=sk_live_xxx
# Browser publishable key — exposed via isPubKeyConfigured() in src/lib/stripe-config.ts. optional
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# Webhook signing secret for POST /api/webhooks/stripe. required if Stripe webhook is wired
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional product IDs (used by src/lib/stripe-config.ts for tier metadata).
STRIPE_PRODUCT_PRO=prod_xxx
STRIPE_PRODUCT_PLUS=prod_xxx
# Pro tier price IDs (read by stripe-config.ts AND stripe-plan.ts).
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
# Plus tier (same IDs for checkout UI in stripe-config.ts and webhook plan mapping in stripe-plan.ts).
STRIPE_PRICE_PRO_PLUS_MONTHLY=price_xxx
STRIPE_PRICE_PRO_PLUS_ANNUAL=price_xxx

# =============================================================================
# Storage — Upstash Redis / Vercel Marketplace KV (optional)
# =============================================================================
# Prefer Vercel Marketplace KV names; classic Upstash names also accepted.
# Without Redis: JSON file at tmp/basiclaw-storage.json (ephemeral on serverless — DO NOT ship to prod).
# recommended (production)
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=
# Or, equivalently:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Email — Resend (optional; required for lead/press/cron emails)
# =============================================================================
# Resend API key (https://resend.com). recommended
RESEND_API_KEY=re_xxx
# Verified sender. Falls back to "BasicLaw <onboarding@resend.dev>" if unset.
RESEND_FROM_EMAIL=BasicLaw <hello@basiclaw.app>
# Inbox for /api/lawyer-leads + /api/lawyer-leads/[slug] + partner-applications fallback. optional
LAWYER_LEADS_EMAIL=leads@basiclaw.app
# Inbox for /api/lawyer-applications (verified-reviewer applications). Falls back to LAWYER_LEADS_EMAIL → RESEND_FROM_EMAIL. optional
LAWYER_APPLICATIONS_EMAIL=lawyers@basiclaw.app
# Inbox for /api/press-contact (Press page form). required for press flow
PRESS_EMAIL=press@basiclaw.app
# From-address for /api/cron/right-of-the-day (must be verified in Resend). required for cron digest
RIGHT_OF_DAY_FROM_EMAIL=BasicLaw Daily <daily@basiclaw.app>

# =============================================================================
# Analytics — PostHog (optional)
# =============================================================================
# Browser + server-side capture key (also baked into the extension build). recommended
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# Region host. Default: https://us.i.posthog.com. Set to https://eu.i.posthog.com for EU cloud. optional
NEXT_PUBLIC_POSTHOG_HOST=

# =============================================================================
# Observability — Sentry (optional; SDK no-ops without DSN)
# =============================================================================
# Browser DSN + shared fallback for server/edge when SENTRY_DSN unset.
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# Optional separate server/edge DSN (otherwise NEXT_PUBLIC_SENTRY_DSN is reused on Node + Edge).
SENTRY_DSN=
# Build-time only: upload source maps during `next build` for readable stacks.
# Leave unset for local builds; set in Vercel/CI together with SENTRY_ORG + SENTRY_PROJECT.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# =============================================================================
# Cron / internal launch (optional in dev, recommended in prod)
# =============================================================================
# Manual non-Vercel cron runs in production: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Long random string. /launch and /[locale]/internal/health both 404 in production unless ?key= matches.
# required (production) before sharing /launch or /internal/health URLs
LAUNCH_KEY=

# =============================================================================
# Newsletter / unsubscribe (optional; HMAC for one-click unsubscribe tokens)
# =============================================================================
# HMAC secret for /api/unsubscribe?token=…  Prefer a dedicated secret in production.
UNSUBSCRIBE_SECRET=
# Alternative name accepted by src/lib/newsletter-token.ts; set EITHER, not both.
NEWSLETTER_UNSUBSCRIBE_SECRET=

# =============================================================================
# Shared audit links (HMAC; optional — falls back to CLERK_SECRET_KEY in dev)
# =============================================================================
# Strong random secret used by src/lib/shared-audit-url.ts. recommended (production)
SHARED_AUDIT_SECRET=

# =============================================================================
# Embed (optional — tenant API keys + signed telemetry)
# =============================================================================
# HMAC secret for embed event tokens (POST /api/embed/event Authorization: Bearer …). See docs/embed.md.
EMBED_JWT_SECRET=

# =============================================================================
# Mobile (Expo) — none
# =============================================================================
# `mobile/` reads no env vars at build time. Configure runtime via mobile/app.json + EAS secrets.

# =============================================================================
# Extension (WXT — build-time only, baked into the bundle)
# =============================================================================
# API origin the extension talks to. Default: https://basiclaw.vercel.app. Set to https://basiclaw.app in prod CI.
BL_API_BASE=https://basiclaw.app
# Reuses the Next.js NEXT_PUBLIC_POSTHOG_KEY above; no separate variable needed.
