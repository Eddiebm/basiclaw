# OpenRouter API key (https://openrouter.ai)
# Required for the legal assistant. Without it, the API returns the constitutional summary fallback.
OPENROUTER_API_KEY=

# Optional override for the model used by the assistant (OpenRouter model id).
# Defaults to openai/gpt-oss-20b:free when unset.
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Public site URL used for canonical links, sitemap, and OpenRouter referrer header.
# Set this to your production URL on Vercel.
NEXT_PUBLIC_SITE_URL=https://basiclaw.vercel.app

# --- Lawyer marketplace (optional email notifications) ---
# If RESEND_API_KEY is set together with a recipient (see below), successful submissions to
# POST /api/lawyer-leads also send you an email copy of the payload.
RESEND_API_KEY=

# Where lawyer-lead notifications are delivered (your inbox). Falls back to RESEND_FROM_EMAIL if unset.
LAWYER_LEADS_EMAIL=

# Verified sender in Resend (e.g. "BasicLaw <notifications@yourdomain.com>").
# Also used as fallback recipient when LAWYER_LEADS_EMAIL is empty.
RESEND_FROM_EMAIL=
