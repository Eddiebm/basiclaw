{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "~/*": ["./*"]
    }
  },
  "include": [
    "entrypoints/**/*",
    "components/**/*",
    "shared/**/*",
    "scripts/**/*",
    "wxt.config.ts",
    "wxt-env.d.ts",
    ".wxt/wxt.d.ts",
    ".wxt/types/**/*.d.ts"
  ]
}
